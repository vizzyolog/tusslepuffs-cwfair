# Tusslepuffs server configuration
# Copy to config.env and adjust. All values have safe defaults except the
# IPFPS block, which is only required when IPFPS_ENABLED=true.

# =============================================================================
# Server
# =============================================================================

SERVER_PORT=8181
SERVER_HOST=0.0.0.0
# Directory with the built frontend (included in this bundle as dist/)
STATIC_DIR=./dist

LOG_LEVEL=info
LOG_FORMAT=text

# =============================================================================
# Game
# =============================================================================

# Game tick rate (ticks per second)
GAME_TPS=20
# Network snapshot rate to clients
NETWORK_FPS=60

# Physics server (rapier-server) gRPC address
PHYSICS_SERVER_ADDR=localhost:50052

# Sponsor coins: food fills the coin's glass; a full glass bursts into mass
COINS_ENABLED=true
FOOD_RADIUS_MULTIPLIER=2.5
COINS_GLASS_INITIAL_CAPACITY=15
COINS_GLASS_GROWTH_FACTOR=1.2

# =============================================================================
# WebSocket
# =============================================================================

WS_TIMEOUT=120
WS_PING_INTERVAL=30
WS_MAX_MESSAGE_SIZE=1024

# =============================================================================
# IPFPS platform integration (optional — guest mode works without it)
# Credentials are issued once at platform onboarding.
# =============================================================================

IPFPS_ENABLED=false
# IPFPS_ENDPOINT=https://your-tenant.ipfps.org
# IPFPS_KEY_ID=your-tenant-key-1
# IPFPS_SECRET=replace-with-tenant-s2s-secret
IPFPS_SEASON=cwfair
IPFPS_TIMEOUT_SECONDS=5

# Scoring: points per attributed kill; death flush = peak_mass / divisor
IPFPS_KILL_SCORE=50
IPFPS_MASS_SCORE_DIVISOR=10

# =============================================================================
# Combat & metabolism
# =============================================================================

# Damage from player/player and player/NPC collisions
ENTITY_ENTITY_DAMAGE_ENABLED=true

# Devour (grab -> hold -> gulp) finisher; attacker must be DEVOUR_RATIO x heavier
DEVOUR_ENABLED=true
DEVOUR_RATIO=3.0

# Adrenaline escape boost after taking damage (+35% speed for 2.5s)
ADRENALINE_BOOST=0.35
ADRENALINE_DURATION_MS=2500

# Metabolism: movement/punches cost mass ~ (mass/100)^1.3
METABOLIC_DRAIN_K=0
METABOLIC_MOVE_K=0.005
METABOLIC_PUNCH_COST=0.5

# =============================================================================
# Telemetry (diagnostic JSONL; disable for a clean self-host)
# =============================================================================

TELEMETRY_ENABLED=false
TELEMETRY_GAMEPLAY_ENABLED=false
